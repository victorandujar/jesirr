---
import { ui, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tx = ui[lang].historia;
---
<section id="historia" aria-labelledby="hist-t" class="scroll-mt-20">
  <div class="mx-auto max-w-[90rem] px-4 py-20 sm:px-8 sm:py-28">
    <p class="label text-roig-fosc" data-reveal>{tx.label}</p>
    <h2 id="hist-t" class="titol mt-4 text-[clamp(2.4rem,5.4vw,4.8rem)]" data-reveal style="--i:1">{tx.title}</h2>
    <ol class="relative mt-14 grid gap-10 md:grid-cols-3">
      <span class="absolute left-0 right-0 top-[2.1rem] hidden h-1 bg-ferro md:block" aria-hidden="true"></span>
      {tx.hitos.map(([any, text], i) => (
        <li class="relative" data-reveal style={`--i:${i}`}>
          <p class="titol relative inline-block bg-crema pr-4 text-5xl text-roig-fosc">{any}</p>
          <p class="mt-5 max-w-xs text-lg">{text}</p>
        </li>
      ))}
    </ol>
    <p class="mt-16 max-w-2xl border-l-4 border-roig pl-6 text-xl" data-reveal>{tx.valores}</p>
  </div>
</section>
