---
import { empresa, mailUrl, movilUrl, telUrl } from '../data/empresa';
import { ui, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tx = ui[lang].contacto;
---
<section id="contacto" aria-labelledby="cont-t" class="planxa scroll-mt-20 text-crema">
  <div class="mx-auto grid max-w-[90rem] gap-12 px-4 py-20 sm:px-8 sm:py-28 lg:grid-cols-12">
    <div class="min-w-0 lg:col-span-6">
      <p class="label text-roig" data-reveal>{tx.label}</p>
      <h2 id="cont-t" class="titol mt-4 text-[clamp(2.6rem,6vw,5.4rem)]" data-reveal style="--i:1">{tx.title}</h2>
      <p class="mt-6 max-w-md text-lg text-crema/75" data-reveal style="--i:2">{tx.text}</p>
      <address class="mt-10 not-italic text-xl" data-reveal style="--i:3">
        {empresa.street}<br />{empresa.postalCode} {empresa.city}
        <a href={empresa.maps} target="_blank" rel="noopener" class="mt-3 block w-fit border-b-2 border-roig pb-1 font-semibold">{tx.llegar} ↗</a>
      </address>
    </div>
    <div class="grid min-w-0 content-start gap-3 lg:col-span-5 lg:col-start-8">
      <a href={telUrl} class="group flex items-center justify-between gap-4 bg-roig-fosc p-6" data-reveal>
        <span><span class="label block text-crema/70">{tx.fijo}</span><span class="titol mt-1 block text-3xl tabular-nums">{empresa.phone.display}</span></span>
        <span aria-hidden="true" class="text-3xl transition-transform group-hover:translate-x-1">→</span>
      </a>
      <a href={movilUrl} class="group flex items-center justify-between gap-4 bg-crema p-6 text-ferro" data-reveal style="--i:1">
        <span><span class="label block text-gris">{tx.movil}</span><span class="titol mt-1 block text-3xl tabular-nums">{empresa.mobile.display}</span></span>
        <span aria-hidden="true" class="text-3xl transition-transform group-hover:translate-x-1">→</span>
      </a>
      <a href={mailUrl(tx.asunto)} class="group flex min-w-0 items-center justify-between gap-4 border-2 border-crema/30 p-6 hover:border-crema" data-reveal style="--i:2">
        <span class="min-w-0"><span class="label block text-crema/60">{tx.email}</span><span class="mt-1 block truncate text-xl font-semibold">{empresa.email}</span></span>
        <span aria-hidden="true" class="text-2xl">→</span>
      </a>
    </div>
  </div>
</section>
