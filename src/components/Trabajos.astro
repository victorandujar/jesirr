---
import { Image } from 'astro:assets';
import { treballs } from '../data/empresa';
import { ui, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tx = ui[lang];
const fotos = import.meta.glob<{ default: ImageMetadata }>('../assets/treballs/*.jpg', { eager: true });
const foto = (n: string) => fotos[`../assets/treballs/${n}.jpg`]!.default;
const cats = Object.keys(treballs) as (keyof typeof treballs)[];
---
<section id="trabajos" aria-labelledby="trab-t" class="planxa scroll-mt-20 text-crema">
  <div class="mx-auto max-w-[90rem] px-4 py-20 sm:px-8 sm:py-28">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="label text-roig" data-reveal>{tx.trabajos.label}</p>
        <h2 id="trab-t" class="titol mt-4 text-[clamp(2.4rem,5.4vw,4.8rem)]" data-reveal style="--i:1">{tx.trabajos.title}</h2>
      </div>
      <p class="text-lg text-crema/70 lg:col-span-4 lg:col-start-9" data-reveal style="--i:2">{tx.trabajos.text}</p>
    </div>
    <div class="mt-14 grid gap-12 lg:grid-cols-2">
      {cats.map((c, ci) => (
        <div data-reveal style={`--i:${ci % 2}`}>
          <h3 class="titol border-t-2 border-roig pt-4 text-2xl">{tx.trabajos.cats[c]}</h3>
          <ul class="mt-5 flex flex-wrap items-end gap-3">
            {treballs[c].map((n) => (
              <li>
                <button type="button" class="group block bg-crema p-1.5 transition-transform duration-300 hover:-translate-y-1 hover:rotate-[-1deg]" data-obre={n} aria-label={`${tx.ver}: ${tx.trabajos.cats[c]}`}>
                  <Image src={foto(n)} alt={tx.trabajos.cats[c]} class="block h-36 w-auto object-cover sm:h-40" loading="lazy" />
                </button>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
  <dialog class="m-auto max-h-[92dvh] max-w-[min(96vw,28rem)] bg-transparent p-0 text-crema backdrop:bg-black/85" data-visor>
    <form method="dialog" class="flex justify-end"><button class="label px-2 py-3 text-crema">{tx.cerrar} ✕</button></form>
    {cats.flatMap((c) => treballs[c].map((n) => (
      <figure data-foto={n} hidden class="bg-crema p-2">
        <Image src={foto(n)} alt={tx.trabajos.cats[c]} class="h-auto w-[min(88vw,26rem)] [image-rendering:auto]" loading="lazy" />
        <figcaption class="mt-2 text-sm font-semibold text-ferro">{tx.trabajos.cats[c]}</figcaption>
      </figure>
    )))}
  </dialog>
</section>

<script>
  const visor = document.querySelector<HTMLDialogElement>('[data-visor]');
  document.querySelectorAll<HTMLButtonElement>('[data-obre]').forEach((b) =>
    b.addEventListener('click', () => {
      if (!visor) return;
      visor.querySelectorAll<HTMLElement>('[data-foto]').forEach((f) => { f.hidden = f.dataset.foto !== b.dataset.obre; });
      visor.showModal();
    }),
  );
  visor?.addEventListener('click', (e) => { if (e.target === visor) visor.close(); });
</script>
